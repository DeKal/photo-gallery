{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "backend": {
      "root": "backend",
      "framework": "fastapi",
      "entrypoint": "app.vercel_app:app"
    },
    "frontend": {
      "root": "frontend",
      "framework": "vite"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "backend" } },
    { "source": "/assets/(.*)", "destination": { "service": "frontend" } },
    { "source": "/index.html", "destination": { "service": "frontend" } },
    { "source": "/icon.png", "destination": { "service": "frontend" } },
    { "source": "/og-image.png", "destination": { "service": "frontend" } },
    { "source": "/favicon.ico", "destination": { "service": "frontend" } },
    { "source": "/", "destination": { "service": "frontend" } },
    { "source": "/(.*)", "destination": { "service": "backend" } }
  ]
}
