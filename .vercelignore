# Keep the Vercel deploy upload small and the Python function slim.
#
# The api function needs only backend/app (pulled in via vercel.json
# includeFiles) -- never the local virtualenv, tests, scripts, SQL, or the ML
# worker's bits. node_modules/dist are rebuilt by the build command.
**/.venv/
**/__pycache__/
**/*.pyc
node_modules/
frontend/dist/
frontend/node_modules/
frontend/test-results/
frontend/e2e/
backend/.venv/
backend/tests/
backend/scripts/
backend/.pytest_cache/
backend/Dockerfile.api
docker-compose.yml
docs/
