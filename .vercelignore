# Keep the Vercel deploy upload small.
#
# The `backend` service builds from backend/ (app package + requirements.txt);
# it never needs the local virtualenv, tests, scripts, or the ML worker's
# native bits. node_modules/dist are rebuilt by each service's framework.
**/.venv/
**/__pycache__/
**/*.pyc
node_modules/
frontend/dist/
frontend/node_modules/
frontend/test-results/
frontend/e2e/
backend/.venv/
backend/tests/
backend/scripts/
backend/.pytest_cache/
backend/Dockerfile.api
docker-compose.yml
docs/
