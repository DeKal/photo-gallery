# Frontend build config for Vercel (production).
#
# The SPA, api function, and static assets are served from one Vercel origin,
# with the slim DB-only API mounted under /api (see root vercel.json rewrite
# and api/index.py). So the REST client talks to /api/* on the same origin --
# no CORS, no separate backend URL.
VITE_API_BASE=/api

# Hosted build is read-only: the ML worker (scan / folder picker / clustering)
# is not deployed to Vercel, so hide the scan UI and Import Folder. Browsing and
# curation (rename/merge/hide/star/albums) still work against the DB-only API.
VITE_NO_WORKER=1

# Hide destructive curation controls (select/merge, hide person) on the hosted
# deploy — it is browse-only. Locally this is empty so desktop keeps curation
# (it is still hidden on mobile via the md breakpoint).
VITE_READONLY=1
